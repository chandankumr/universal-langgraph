# ===========================
# APPLICATION SETTINGS
# ===========================
APP_NAME=Universal LangGraph Platform
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ENCRYPTION_KEY=32-byte-encryption-key-here!!
DATABASE_URL=postgresql://postgres:postgres@db:5432/langgraph_platform

# ===========================
# LLM PROVIDERS (Add your keys)
# ===========================
# OpenAI
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o

# Azure OpenAI
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google
GOOGLE_API_KEY=your-google-key-here

# Ollama (Local - No Key Needed)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1:8b
OLLAMA_MODEL=qwen2.5:3b

# ===========================
# EMBEDDING SETTINGS
# ===========================
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ===========================
# VECTOR DATABASE
# ===========================
DEFAULT_VECTOR_DB=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# Pinecone (Optional)
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=us-west1-gcp

# Qdrant (Optional)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ===========================
# MONITORING (LangSmith)
# ===========================
# LANGCHAIN_TRACING_V2=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=universal-langgraph

# ===========================
# REDIS CACHE
# ===========================
REDIS_URL=redis://redis:6379/0

# ===========================
# HARDWARE SETTINGS
# ===========================
# Set to 'nvidia' for RTX 4070, 'rocm' for AMD, 'cpu' for no GPU
# GPU_TYPE=nvidia
# For Mac M1, set GPU to cpu (or mps for Metal)
GPU_TYPE=cpu
MAX_CONTEXT_WINDOW=4096
MAX_RETRIEVAL_K=5

# Limit the agent to 3 iterations max
MAX_LOOP_ITERATIONS=3